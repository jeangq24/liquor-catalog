DATABASE_URL=postgresql://postgres:postgres@localhost:5432/licoresyaaa

# Documentation is disabled unless explicitly enabled; restrict access in deployed environments.
# SWAGGER_ENABLED=true

# Configure a random secret of at least 32 characters in the trusted BFF and Catalog.
# CATALOG_INTERNAL_API_TOKEN=

# Configure a different random secret (at least 32 characters) for trusted services.
# CATALOG_SERVICE_API_TOKEN=

# Optional: dedicated PostgreSQL database for schema integration tests.
# Apply migrations to this database before running pnpm test:postgres.
# POSTGRES_TEST_DATABASE_URL=